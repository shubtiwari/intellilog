{
  "name": "intellilog",
  "displayName": "IntelliLog",
  "description": "Smart log insertion for JS, TS, Python, Go, PHP, Ruby, Rust, and Flutter/Dart — file+line context, gutter icons, function wrap, log cleanup, and structured JSON output.",
  "version": "0.2.0",
  "icon": "icon.png",
  "publisher": "intellilog",
  "author": {
    "name": "Shubham Tiwari",
    "url": "https://github.com/shubtiwari"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/shubtiwari/intellilog.git"
  },
  "bugs": {
    "url": "https://github.com/shubtiwari/intellilog/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Other",
    "Snippets"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "IntelliLog",
      "properties": {
        "intellilog.logPrefix": {
          "type": "string",
          "default": "🎯",
          "description": "The emoji or prefix string inserted before the variable name in log statements."
        },
        "intellilog.insertArrow": {
          "type": "boolean",
          "default": true,
          "description": "Whether to insert a colon (:) after the variable name in the log string."
        },
        "intellilog.structuredOutput": {
          "type": "boolean",
          "default": false,
          "description": "Output logs as JSON.stringify / json.dumps for use with log aggregators like Datadog, Splunk, or CloudWatch. Supported in JS/TS and Python."
        }
      }
    },
    "commands": [
      {
        "command": "intellilog.smartLog",
        "title": "IntelliLog: Smart Insert Log"
      },
      {
        "command": "intellilog.wrapFunction",
        "title": "IntelliLog: Wrap Function with Entry Log"
      },
      {
        "command": "intellilog.commentAllLogs",
        "title": "IntelliLog: Comment All Logs"
      },
      {
        "command": "intellilog.uncommentAllLogs",
        "title": "IntelliLog: Uncomment All Logs"
      },
      {
        "command": "intellilog.deleteAllLogs",
        "title": "IntelliLog: Delete All Logs"
      }
    ],
    "keybindings": [
      {
        "command": "intellilog.smartLog",
        "key": "cmd+alt+l",
        "win": "ctrl+alt+l",
        "when": "editorTextFocus"
      },
      {
        "command": "intellilog.wrapFunction",
        "key": "cmd+alt+w",
        "win": "ctrl+alt+w",
        "when": "editorTextFocus"
      },
      {
        "command": "intellilog.commentAllLogs",
        "key": "cmd+alt+/",
        "win": "ctrl+alt+/",
        "when": "editorTextFocus"
      },
      {
        "command": "intellilog.deleteAllLogs",
        "key": "cmd+alt+d",
        "win": "ctrl+alt+d",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "esbuild": "^0.27.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
